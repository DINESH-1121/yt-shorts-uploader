# Google OAuth 2.0 Credentials
# Get these from: https://console.cloud.google.com/apis/credentials
CLIENT_ID=your_client_id_here
CLIENT_SECRET=your_client_secret_here

# Server port (default 3000)
PORT=3000

# ── YouTube authentication for yt-dlp ───────────────────────────────────
# YouTube requires a signed-in cookie jar for most downloads ("Sign in to
# confirm you're not a bot"). Set ONE of these:
#
# 1) Reuse cookies from a browser where you are signed in to YouTube:
# YTDLP_COOKIES_FROM_BROWSER=chrome        # chrome | edge | safari | firefox
#
# 2) Or point at an exported Netscape cookies.txt file:
# YTDLP_COOKIES=/absolute/path/to/cookies.txt
#
# Optional extractor override (rarely needed):
# YTDLP_PLAYER_CLIENT=default

# ── AI Engine Configuration ──────────────────────────────────────────────
# Google Gemini API key (recommended: fast, reliable, no IP blocking issues)
# Get a key from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Disable OpenCode CLI completely (recommended if OpenCode free tier has IP blocks)
DISABLE_OPENCODE=true

# ── Local Apple Silicon MLX Configuration (Ultra Fast Metal GPU) ─────────
# Runs natively on Apple Silicon GPU with unified memory (zero rate limits, ultra fast):
USE_MLX=true
MLX_MODEL=mlx-community/Llama-3.2-3B-Instruct-4bit
MLX_BASE_URL=http://127.0.0.1:8080


